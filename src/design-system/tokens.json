{
  "name": "BladeRunner Labs",
  "version": "0.2.0",
  "color": {
    "gray": {
      "0": "#FFFFFF",
      "50": "#F8F8F8",
      "100": "#F1F1F1",
      "200": "#E4E4E4",
      "300": "#C8C8C8",
      "400": "#A3A3A3",
      "500": "#767676",
      "600": "#5A5A5A",
      "700": "#3F3F3F",
      "800": "#2C2C2C",
      "900": "#1A1A1A",
      "950": "#101010"
    },
    "accent": {
      "default": "#1F51FF",
      "hover": "#1941CC",
      "pressed": "#1639B3",
      "on-dark": "#90A9FF",
      "subtle": "rgba(31, 81, 255, 0.10)"
    },
    "theme": {
      "light": {
        "surface": "--gray-0",
        "surface-inverse": "--gray-900",
        "surface-subtle": "--gray-50",
        "surface-muted": "--gray-100",
        "text": "--gray-900",
        "text-secondary": "--gray-600",
        "text-muted": "--gray-500",
        "text-inverse": "--gray-0",
        "border": "--gray-200",
        "border-strong": "--gray-400",
        "link": "--accent",
        "focus": "--accent",
        "secondary-hover": "--gray-50",
        "tertiary-hover": "--gray-200",
        "disabled-bg": "--gray-100",
        "disabled-fg": "--gray-400"
      },
      "dark": {
        "surface": "--gray-900",
        "surface-inverse": "--gray-0",
        "surface-subtle": "--gray-800",
        "surface-muted": "--gray-700",
        "text": "--gray-0",
        "text-secondary": "--gray-300",
        "text-muted": "--gray-400",
        "text-inverse": "--gray-900",
        "border": "--gray-700",
        "border-strong": "--gray-500",
        "link": "--accent-on-dark",
        "focus": "--accent-on-dark",
        "secondary-hover": "--gray-800",
        "tertiary-hover": "--gray-600",
        "disabled-bg": "--gray-700",
        "disabled-fg": "--gray-500"
      }
    },
    "surfaces": {
      "white": "#FFFFFF",
      "light-gray": "#F8F8F8",
      "dark": "#1A1A1A"
    }
  },
  "font": {
    "heading": "IBM Plex Sans",
    "body": "Inter",
    "button": "IBM Plex Mono",
    "notes": "Headings load IBM Plex Sans from Google Fonts; Inter and IBM Plex Mono are local files in fonts/."
  },
  "type": {
    "display": {
      "family": "heading",
      "size": 80,
      "lineHeight": 96,
      "weight": 700,
      "tracking": "-0.022em"
    },
    "h1": {
      "family": "heading",
      "size": 64,
      "lineHeight": 72,
      "weight": 700,
      "tracking": "-0.022em"
    },
    "h2": {
      "family": "heading",
      "size": 48,
      "lineHeight": 56,
      "weight": 700,
      "tracking": "-0.02em"
    },
    "h3": {
      "family": "heading",
      "size": 36,
      "lineHeight": 44,
      "weight": 600,
      "tracking": "-0.018em"
    },
    "h4": {
      "family": "heading",
      "size": 28,
      "lineHeight": 36,
      "weight": 600,
      "tracking": "-0.015em"
    },
    "h5": {
      "family": "heading",
      "size": 24,
      "lineHeight": 32,
      "weight": 600,
      "tracking": "-0.012em"
    },
    "h6": {
      "family": "heading",
      "size": 20,
      "lineHeight": 28,
      "weight": 600,
      "tracking": "-0.01em"
    },
    "body-lg": {
      "family": "body",
      "size": 20,
      "lineHeight": 32,
      "weight": 400,
      "tracking": "0"
    },
    "body": {
      "family": "body",
      "size": 16,
      "lineHeight": 24,
      "weight": 400,
      "tracking": "0"
    },
    "body-sm": {
      "family": "body",
      "size": 14,
      "lineHeight": 20,
      "weight": 400,
      "tracking": "0"
    },
    "caption": {
      "family": "body",
      "size": 12,
      "lineHeight": 16,
      "weight": 400,
      "tracking": "0"
    },
    "label": {
      "family": "body",
      "size": 14,
      "lineHeight": 20,
      "weight": 500,
      "tracking": "0"
    },
    "button": {
      "family": "button",
      "size": 14,
      "lineHeight": 20,
      "weight": 500,
      "tracking": "0.06em",
      "transform": "uppercase"
    },
    "button-sm": {
      "family": "button",
      "size": 13,
      "lineHeight": 20,
      "weight": 500,
      "tracking": "0.06em",
      "transform": "uppercase"
    },
    "button-lg": {
      "family": "button",
      "size": 15,
      "lineHeight": 20,
      "weight": 500,
      "tracking": "0.06em",
      "transform": "uppercase"
    },
    "mono-label": {
      "family": "button",
      "size": 12,
      "lineHeight": 16,
      "weight": 500,
      "tracking": "0.08em",
      "transform": "uppercase"
    }
  },
  "spacing": [
    0,
    4,
    8,
    12,
    16,
    20,
    24,
    28,
    32,
    40,
    48,
    56,
    64,
    80,
    96,
    128
  ],
  "radius": [
    2,
    4,
    8,
    10,
    12,
    16,
    24,
    32,
    40,
    48,
    56,
    64,
    999999
  ],
  "responsive": {
    "maxWidth640": {
      "display": [
        48,
        58
      ],
      "h1": [
        40,
        48
      ],
      "h2": [
        32,
        40
      ],
      "h3": [
        28,
        36
      ],
      "h4": [
        24,
        32
      ],
      "h5": [
        20,
        28
      ],
      "body-lg": [
        18,
        28
      ]
    }
  },
  "button": {
    "height": {
      "sm": 40,
      "md": 48,
      "lg": 56
    },
    "paddingInline": {
      "sm": 20,
      "md": 24,
      "lg": 32
    },
    "radius": {
      "sm": 24,
      "md": 24,
      "lg": 32
    },
    "variants": [
      "primary",
      "secondary",
      "tertiary",
      "ghost",
      "link"
    ],
    "notes": "Ghost and link are text-only: zero padding, zero radius, no height. Secondary border is gray-300, hover border gray-900 on gray-100."
  },
  "decorative": {
    "hero-gradient": [
      "radial-gradient(60% 65% at 78% 12%, rgba(31,81,255,0.28) 0%, rgba(31,81,255,0) 60%)",
      "radial-gradient(55% 60% at 22% 88%, rgba(31,81,255,0.34) 0%, rgba(31,81,255,0) 62%)",
      "radial-gradient(45% 55% at 62% 78%, rgba(74,132,255,0.22) 0%, rgba(74,132,255,0) 60%)",
      "radial-gradient(50% 50% at 12% 20%, rgba(144,190,255,0.30) 0%, rgba(144,190,255,0) 60%)",
      "linear-gradient(135deg, #F4F9FF 0%, #EAF4FF 45%, #E4F1FF 100%)"
    ],
    "bubble-fill": "radial-gradient(circle at 30% 26%, #FFFFFF 0%, #EAF3FF 40%, #9FC2FF 78%, #6FA1FF 100%)",
    "bubble-shadow": [
      "inset -8px -10px 24px rgba(60,110,220,0.30)",
      "inset 6px 8px 20px rgba(255,255,255,0.95)",
      "0 30px 60px -24px rgba(31,81,255,0.30)"
    ],
    "notes": "Hero only. Bubbles sit in three depth tiers \u2014 near stays sharp, mid and far blur \u2014 with an iridescent conic sheen multiplied at the rim, where soap film actually carries colour. The sheen runs cool blues through violet into a warm amber arc. None of these belong to the gray palette; never use them for text, surfaces or controls.",
    "bubble-sheen": "conic-gradient(from 205deg at 50% 50%, rgba(130, 220, 255, 0.80) 0%, rgba(150, 180, 255, 0.80) 20%, rgba(190, 160, 255, 0.70) 38%, rgba(255, 186, 140, 0.65) 56%, rgba(255, 224, 170, 0.55) 66%, rgba(150, 230, 255, 0.75) 84%, rgba(130, 220, 255, 0.80) 100%)",
    "bubble-sheen-opacity": "0.9",
    "bubble-sheen-mask": "radial-gradient(circle, rgba(0,0,0,0) 34%, #000 72%, #000 93%, rgba(0,0,0,0) 100%)",
    "bubble-blur-near": "0px",
    "bubble-blur-mid": "4px",
    "bubble-blur-far": "10px"
  }
}
