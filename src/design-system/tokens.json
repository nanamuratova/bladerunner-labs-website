    ],
    "bubble-fill": "radial-gradient(circle at 38% 34%, rgba(226, 240, 255, 0.80) 0%, rgba(178, 208, 255, 0.58) 26%, rgba(150, 188, 255, 0.34) 48%, rgba(140, 180, 255, 0.16) 68%, rgba(140, 180, 255, 0.05) 84%, rgba(140, 180, 255, 0) 100%)",
    "bubble-fill-violet": "radial-gradient(circle at 42% 36%, rgba(236, 232, 255, 0.78) 0%, rgba(200, 186, 255, 0.55) 28%, rgba(178, 158, 255, 0.32) 50%, rgba(170, 150, 255, 0.14) 70%, rgba(170, 150, 255, 0.04) 85%, rgba(170, 150, 255, 0) 100%)",
    "bubble-fill-blush": "radial-gradient(circle at 40% 38%, rgba(255, 240, 250, 0.72) 0%, rgba(255, 210, 238, 0.48) 28%, rgba(248, 188, 228, 0.26) 50%, rgba(245, 180, 225, 0.11) 70%, rgba(245, 180, 225, 0.03) 85%, rgba(245, 180, 225, 0) 100%)",
    "bubble-fill-edge": "radial-gradient(circle at 36% 30%, rgba(255, 252, 250, 0.92) 0%, rgba(255, 224, 240, 0.72) 34%, rgba(226, 214, 255, 0.60) 62%, rgba(186, 206, 255, 0.52) 86%, rgba(186, 206, 255, 0.30) 95%, rgba(186, 206, 255, 0) 100%)",
    "bubble-sheen": "conic-gradient(from 210deg at 50% 50%, rgba(120, 215, 255, 0.85) 0%, rgba(150, 170, 255, 0.85) 20%, rgba(190, 150, 255, 0.80) 38%, rgba(255, 170, 230, 0.70) 55%, rgba(150, 230, 255, 0.80) 78%, rgba(120, 215, 255, 0.85) 100%)",
    "bubble-sheen-mask": "radial-gradient(circle, #000 30%, rgba(0, 0, 0, 0) 72%)",
    "bubble-blur": "10px",
    "bubble-blur-edge": "2px",
    "grain-opacity": "0.30",
    "grain-texture": "SVG feTurbulence tile, 180x180, blended with overlay over the hero",
    "notes": "Hero only. A bubble is a flat gradient field that fades out at its edge, with an iridescent conic sheen blended with overlay and masked to fade with the shape; one shape (bubble--edge) keeps a defined horizon. Grain sits above the gradient and the shapes, below the content. None of these belong to the gray palette \u2014 never use them for text, surfaces or controls."
  }
